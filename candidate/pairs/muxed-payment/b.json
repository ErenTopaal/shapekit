{
  "schema_version": 1,
  "id": "pairs.muxed-payment",
  "family": "explore",
  "protocol": 30,
  "node": {
    "soroban_settings": false,
    "soroban_limits": false,
    "emit_classic_events": true,
    "backfill_stellar_asset_events": true
  },
  "below_protocol_valid": false,
  "steps": [
    {
      "step": "fund",
      "roles": [
        "payer",
        "payee"
      ],
      "balance": "100000000000"
    },
    {
      "step": "close"
    },
    {
      "step": "tx",
      "source": "payer",
      "operations": [
        {
          "body": {
            "payment": {
              "amount": "100000000",
              "asset": "native",
              "destination": "@muxed:payee:1234"
            }
          },
          "source_account": null
        }
      ],
      "signers": [],
      "expect": {
        "outcome": "success",
        "result": {
          "tx_success": [
            {
              "op_inner": {
                "payment": "success"
              }
            }
          ]
        }
      }
    },
    {
      "step": "close"
    }
  ]
}
