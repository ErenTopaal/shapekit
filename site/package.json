{
  "name": "shapekit-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "content": "node scripts/docs-content.ts",
    "dev": "npm run content && react-router dev",
