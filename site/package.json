  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.1",
    "fumadocs-ui": "16.19.0",
    "isbot": "5.2.3",
    "lucide-react": "1.72.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/mdx": "2.0.13",
