<!-- the .net testee built against stellar-dotnet-sdk 17.0.0. every version directory shares
     the sources in testees/dotnet; only the pins differ. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Shapekit.Testee</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="stellar-dotnet-sdk" Version="17.0.0" />
  </ItemGroup>
</Project>
